---
import Base from '../layouts/Base.astro';
import { NotFound } from '../components/NotFound';
import { profile } from '../data/cv';

const title = `Page not found | ${profile.name}`;
const description = `This page does not exist on the site of ${profile.name}.`;
---

<Base title={title} description={description} indexable={false}>
  <NotFound homeHref={import.meta.env.BASE_URL} />
</Base>
