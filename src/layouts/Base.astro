---
import { BG } from '../styles/theme.css';
import '../styles/global.css';
import { NEW_TAB_HINT_ID } from '../styles/hints';
import { profile } from '../data/cv';
import { buildJsonLd } from '../lib/jsonld';
import bebasUrl from '../assets/fonts/bebas-neue-bold.woff2?url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og.jpg?v=2`, Astro.site).href;
const ogImageAlt = `${profile.name}, ${profile.title}`;
const GOOGLE_TAG_ID = 'GTM-KJCMZ6M5';
const googleTagUrl = `https://www.googletagmanager.com/gtm.js?id=${GOOGLE_TAG_ID}`;
const analyticsEnabled = import.meta.env.PROD;

const jsonLd = buildJsonLd({
  canonical,
  image: ogImage,
  description,
  dateModified: new Date().toISOString(),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {analyticsEnabled && <script is:inline define:vars={{ googleTagUrl }}>
      (function () {
        var EXCLUDE_KEY = 'analytics_exclude';
        var CONSENT_KEY = 'analytics_consent';
        var TAG_IDLE_DELAY_MS = 5000;
        var FIRST_INTERACTIONS = [
          'pointerdown',
          'pointermove',
          'touchstart',
          'keydown',
          'wheel',
          'scroll',
        ];
        var LISTENER_OPTIONS = { capture: true, passive: true };
        var storage = {
          read: function (key) {
            try {
              return localStorage.getItem(key);
            } catch (error) {
              return null;
            }
          },
          write: function (key, value) {
            try {
              if (value === null) localStorage.removeItem(key);
              else localStorage.setItem(key, value);
            } catch (error) {
              return;
            }
          },
        };

        var requestedExclusion = new URLSearchParams(location.search).get(EXCLUDE_KEY);
        if (requestedExclusion !== null)
          storage.write(EXCLUDE_KEY, requestedExclusion === '0' ? null : '1');
        if (storage.read(EXCLUDE_KEY)) return;

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };

        var setAnalyticsStorage = function (state) {
          storage.write(CONSENT_KEY, state);
          window.gtag('consent', 'update', { analytics_storage: state });
        };
        window.grantAnalyticsConsent = function () {
          setAnalyticsStorage('granted');
        };
        var removeAnalyticsCookies = function () {
          document.cookie.split(';').forEach(function (pair) {
            var name = pair.split('=')[0].trim();
            if (name.indexOf('_ga') !== 0) return;
            var expired = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
            document.cookie = expired;
            document.cookie = expired + '; domain=' + location.hostname;
          });
        };
        window.denyAnalyticsConsent = function () {
          setAnalyticsStorage('denied');
          removeAnalyticsCookies();
        };

        window.gtag('consent', 'default', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
        var storedConsent = storage.read(CONSENT_KEY);
        window.analyticsConsentPending = storedConsent === null;
        if (storedConsent === 'granted')
          window.gtag('consent', 'update', { analytics_storage: 'granted' });
        window.gtag('js', new Date());

        var tagRequested = false;
        var requestTag = function () {
          if (tagRequested) return;
          tagRequested = true;
          FIRST_INTERACTIONS.forEach(function (type) {
            removeEventListener(type, requestTag, LISTENER_OPTIONS);
          });
          var tag = document.createElement('script');
          tag.async = true;
          tag.src = googleTagUrl;
          tag.setAttribute('data-analytics', '');
          document.head.appendChild(tag);
        };
        FIRST_INTERACTIONS.forEach(function (type) {
          addEventListener(type, requestTag, LISTENER_OPTIONS);
        });
        var requestTagWhenIdle = function () {
          setTimeout(requestTag, TAG_IDLE_DELAY_MS);
        };
        if (document.readyState === 'complete') requestTagWhenIdle();
        else addEventListener('load', requestTagWhenIdle);
      })();
    </script>}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="UvdhO1XK39hxhnoYdXQ6r5I-rbfN0PWdhoMc5r-yorY" />
    <meta name="theme-color" content={BG} />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" as="font" type="font/woff2" href={bebasUrl} crossorigin />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="profile:first_name" content={profile.firstName} />
    <meta property="profile:last_name" content={profile.lastName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <style is:inline>
      @page {
        size: A4;
        margin: 12mm 13mm;
      }
    </style>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        function bail(reason) {
          if (window.__motionReady || !root.classList.contains('js')) return;
          root.classList.remove('js');
          if (window.gtag) window.gtag('event', 'motion_fallback', { reason: reason });
        }
        setTimeout(function () {
          bail('timeout');
        }, 4000);
        addEventListener(
          'error',
          function (e) {
            var failed = e.target;
            if (failed && failed.tagName === 'SCRIPT' && !failed.hasAttribute('data-analytics'))
              bail('script_error');
          },
          true,
        );
      })();
    </script>
  </head>
  <body>
    <span id={NEW_TAB_HINT_ID} hidden>
      Opens in a new tab
    </span>
    <slot />
    {analyticsEnabled && <script is:inline>
      (function () {
        var banner = document.querySelector('[data-consent-banner]');
        if (banner && window.analyticsConsentPending) banner.hidden = false;
      })();
    </script>}
    <script>
      import { afterPaint } from '../lib/after-paint';
      import { startPage } from '../scripts/main';

      afterPaint(startPage);
    </script>
  </body>
</html>
